---
import BuildCard from "./BuildCard.astro";
import { type TBuild } from "@/type";

interface Props {
    builds: (TBuild & { id: string })[];
}

const { builds } = Astro.props
---
<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    {builds.map((build) => (
        <BuildCard build={build} />
    ))}
</div>