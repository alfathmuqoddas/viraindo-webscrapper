---
import { type TBuild } from "@/type";
import {currencyFormatter} from "@/lib/helper";

const { buildParts } = Astro.props as { buildParts: TBuild["parts"], buildTitle: TBuild["title"], buildUserName: TBuild["userName"], buildUserPhotoUrl: TBuild["userPhotoUrl"] };

const totalPrice = buildParts.reduce((acc, part) => acc + part.price, 0);
---
<div class="p-4 rounded-lg shadow bg-white flex flex-col w-full md:w-1/4">
    <h2 class="font-bold">Part List</h2>
    <div class="flex flex-col divide-y divide-gray-300">
        {buildParts.map((part) => (
            <span class="flex flex-col gap-1 py-2 text-justify">
                <p class="text-xs text-gray-500">{part.type}</p>
                <p class="font-semibold text-sm">{part.model}</p>
                <p class="text-sm">{currencyFormatter.format(part.price)}</p>
            </span>
        ))}
    </div>
    <h1>Total Price: {currencyFormatter.format(totalPrice)}</h1>
</div>