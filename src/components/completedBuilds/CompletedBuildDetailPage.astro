---
import BuildCardDetail from "./BuildCardDetail.astro";
import { type TBuild } from "@/type";

const { buildProps } = Astro.props as { buildProps: TBuild, buildTitle: string, buildUserName: string, buildUserPhotoUrl: string };
---
<div class="flex flex-col md:flex-row gap-4 md:gap-8">
    <BuildCardDetail buildParts={buildProps.parts} buildTitle={buildProps.title} buildUserName={buildProps.userName} buildUserPhotoUrl={buildProps.userPhotoUrl} />
    <div class="w-full md:w-3/4">
            <div class="mb-4">
                <h1 class="font-bold text-xl mb-2">
                    {buildProps.title}
                </h1>
                <div class="flex items-center gap-1">
                    <figure class="size-8 rounded-full overflow-hidden shrink-0">
                        <img
                            src={buildProps.userPhotoUrl}
                            alt={`${buildProps.userName}'s profile picture`}
                            class="w-full h-full object-cover"
                        />
                    </figure>
                    <span class="text-sm">
                        {buildProps.userName}
                    </span>
                </div>
            </div>
            <h2 class="font-bold text-lg">Description</h2>
            <p class="text-justify text-gray-500">
                {buildProps.description}
            </p>
    </div>
</div>