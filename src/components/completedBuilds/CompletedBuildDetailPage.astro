---
import BuildCardDetail from "./BuildCardDetail.astro";
import { type TBuild } from "@/type";

const { buildProps } = Astro.props as { buildProps: TBuild & { id: string } };
---
<div class="flex flex-col md:flex-row gap-4 md:gap-8">
    <BuildCardDetail buildParts={buildProps.parts} buildTitle={buildProps.title} buildUserName={buildProps.userName} buildUserPhotoUrl={buildProps.userPhotoUrl} />
    <div class="flex flex-col gap-2 w-full md:w-3/4">
        <div>
            <h2 class="font-bold text-lg">Description</h2>
            <p class="text-sm text-gray-500">
                {buildProps.description}
            </p>
        </div>
    </div>
</div>