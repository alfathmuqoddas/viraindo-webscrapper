---
import data from "@/data.json";
import AppLayout from "@/layout/AppLayout.astro";
import MainLayout from "@/layout/MainLayout.astro";
import { ProductTable } from "@/components/ProductTable";
import {slugify} from "@/lib/helper"
import type { PartWithoutId } from "@/type";

// 2. Define the props this page expects
interface Props {
  products: PartWithoutId[];
  brandName: string;
}

export const prerender = true;

export async function getStaticPaths() {
  const brandPathsMap = new Map();
  const allPathsMap = new Map()

  for (const item of data) {
    if (!item.type) continue;

    const type = item.type.toLowerCase();

    if (!allPathsMap.has(type)) {
      allPathsMap.set(type, {
        params: {type, brand: "all"},
        props: {
          brandName: "All Brands",
          products: [],
        }
      })
    }
    allPathsMap.get(type).props.products.push(item)

    if (!item.brand) continue;
    const brandSlug = slugify(item.brand);
    if (!brandSlug) continue;

    const key = `${type}/${brandSlug}`;

    if (!brandPathsMap.has(key)) {
      brandPathsMap.set(key, {
        params: { type, brand: brandSlug },
        props: {
          brandName: item.brand,
          products: [],
        },
      });
    }

    // Push product directly in O(1) time
    brandPathsMap.get(key).props.products.push(item);
  }

  return [...Array.from(allPathsMap.values()),...Array.from(brandPathsMap.values())]
}

const { type } = Astro.params;
const { products, brandName } = Astro.props as Props

const metaTitle = `${brandName} ${type}(s) | Viraindo Webscrapper`;
const metaDescription = `Viraindo Webscrapper - ${brandName} ${type}(s) - ${products.length} item(s) found`;
---

<AppLayout>
    <title slot="head">{brandName} {type}(s) | Viraindo Webscrapper</title>
    <meta name="description" slot="head" content={metaDescription} />
    <meta name="keywords" slot="head" content={`${brandName} ${type}(s), viraindo, webscrapper, scrapper, scraping, scrape, viraindo-webscrapper, viraindo-scrapper, viraindo-scraping, viraindo-scrape, viraindo-scraper, viraindo-scraping, viraindo-scrape`} />
    <meta name="author" slot="head" content="Alfath Muqoddas" />
    <meta name="robots" slot="head" content="index, follow" />
    <meta property="og:title" slot="head" content={metaTitle} />
    <meta property="og:description" slot="head" content={metaDescription} />
    <MainLayout>
        <div class="mb-4">
          <h1 class="text-5xl tracking-tight">{brandName} {type}</h1>
          <p>{products.length} item(s) found</p>
        </div>
        <ProductTable products={products} client:load />
    </MainLayout>
</AppLayout>