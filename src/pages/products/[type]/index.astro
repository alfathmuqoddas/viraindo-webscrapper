---
import data from "@/data.json";
import AppLayout from "@/layout/AppLayout.astro";
import MainLayout from "@/layout/MainLayout.astro";
import {slugify} from "@/lib/helper"

export const prerender = true;

export async function getStaticPaths() {
  const typeMap = new Map();

  for (const item of data) {
    if (!item.type || !item.brand) continue;

    const type = item.type.toLowerCase();
    const brandName = item.brand.toUpperCase();

    if (!typeMap.has(type)) {
      typeMap.set(type, new Set());
    }

    typeMap.get(type).add(brandName);
  }

  return Array.from(typeMap.entries()).map(([type, brandsSet]) => ({
    params: { type },
    props: {
      brands: Array.from(brandsSet),
    },
  }));
}

type Props = {
  brands: string[];
}

const { type } = Astro.params;
const { brands } = Astro.props;
---
<AppLayout>
    <title slot="head">Select {type} brand | By Alfath Muqoddas</title>
    <meta name="description" slot="head" content="Viraindo Webscrapper is a simple Astro project that scrapes the Viraindo website and then generate a static website with the scraped data." />
    <meta name="keywords" slot="head" content="Astro, AstroJS, Astro Website, Astro Webscrapper, Viraindo, Viraindo Webscrapper, Alfath Muqoddas, Alfath, Muqoddas" />
    <meta name="author" slot="head" content="Alfath Muqoddas" />
    <meta name="robots" slot="head" content="index, follow" />
    <MainLayout>
        <h1 class="mb-4 text-5xl tracking-tighter">Select {type} brand</h1>
        <ul class="divide-y divide-gray-300 border border-gray-300 rounded-xl bg-white">
            {brands?.map(brand => {
                return (
                <li class="p-4">
                  <a class="uppercase tracking-wider font-medium hover:underline active:underline underline-offset-2" href={`${import.meta.env.BASE_URL}products/${type}/${slugify(brand)}`}>{brand}</a>
                </li>
                )
            })}
        </ul>
    </MainLayout>
</AppLayout>