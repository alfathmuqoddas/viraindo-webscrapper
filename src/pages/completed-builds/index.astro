---
import AppLayout from "@/layout/AppLayout.astro";
import MainLayout from "@/layout/MainLayout.astro";
import { dbLite } from "@/firebase/client";
import { type TBuild } from "@/type";
import {collection, query, orderBy, limit, getDocs, where,type QueryConstraint} from "firebase/firestore/lite"
import {CompletedBuildPage} from "@/components/completedBuilds/CompletedBuildPage"

const PAGE_LIMIT = 12

let initialBuilds: (TBuild & { id: string })[] = []
let initialCursorValue: number | string | null = null
let initialHasMore = true
let error: any = null

try {
    const postRef = collection(dbLite, "pcpart_builds")

    const constraints: QueryConstraint[] = [
        where("isPublished", "==", true),
        orderBy("createdAt", "desc"),
        limit(PAGE_LIMIT),
    ]

    const q = query(postRef, ...constraints)
    const snapshot = await getDocs(q)

    initialBuilds = snapshot.docs.map((doc) => ({
        id: doc.id,
        ...(doc.data() as TBuild),
    }))

   if (initialBuilds.length > 0) {
        const lastBuild = initialBuilds[initialBuilds.length - 1];
        const rawCreatedAt = lastBuild?.createdAt as any;

        if (rawCreatedAt && typeof rawCreatedAt.toMillis === "function") {
            initialCursorValue = rawCreatedAt.toMillis();
        } else if (rawCreatedAt && typeof rawCreatedAt.seconds === "number") {
            initialCursorValue = rawCreatedAt.seconds * 1000;
        } else if (typeof rawCreatedAt === "number") {
            initialCursorValue = rawCreatedAt;
        }
    }

    if (snapshot.docs.length < PAGE_LIMIT) {
        initialHasMore = false
    }
} catch (e) {
    console.error("Astro SSR Fetch Error:", e)
    error = e instanceof Error ? e.message : "Failed to fetch data";
}

---
<AppLayout>
    <title slot="head">Completed Build | PCPART</title>
    <meta name="description" slot="head" content="Here you can see all the completed builds the community has made. | PCPART by Alfath Muqoddas" />
    <MainLayout>
        <h1 class="mb-4 text-5xl font-black tracking-tighter">Completed Builds</h1>
        {
            error ? (
                <p class="wrap-break-words">Error: {error}</p>
            ) : (
                <CompletedBuildPage initialBuilds={initialBuilds} initialHasMore={initialHasMore} initialCursorValue={initialCursorValue} client:load />
            )
        }
    </MainLayout>
</AppLayout>